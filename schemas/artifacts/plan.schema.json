     "type": "string"
    },
    "evidence_ids": {
     "items": {
      "type": "string"
     },
     "title": "Evidence Ids",
     "type": "array"
    }
   },
   "required": [
    "assumption_id",
    "status"
   ],
   "title": "AssumptionCheck",
   "type": "object"
  },
  "FocusTrace": {
   "additionalProperties": false,
   "description": "Where the plan checks one of N08's focus rules (backlog N-22: a build broke two and passed, because no scenario\nchecked them). Exactly one of: a scenario step that is an `expect_focus`, a browser check that covers the rule, or\nthe reason it is out of scope for this prototype.",
   "properties": {
    "rule": {
     "title": "Rule",
     "type": "string"
    },
    "scenario": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Scenario"
    },
    "step": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Step"
    },
    "covered_by": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Covered By"
    },
    "out_of_scope": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Out Of Scope"
    }
   },
   "required": [
    "rule"
   ],
   "title": "FocusTrace",
   "type": "object"
  },
  "Scenario": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "title": "Id",
     "type": "string"
    },
    "flow_id": {
     "title": "Flow Id",
     "type": "string"
    },
    "name": {
     "title": "Name",
     "type": "string"
    },
    "steps": {
