   "metric": "median time to release a compliant lot",
   "threshold": "≤ 4 min (baseline 11 min)"
  },
  {
   "id": "T-03",
   "metric": "reviewers who try to bypass the release guard",
   "threshold": "≤ 1 of 5"
  }
 ],
 "out_of_scope": [
