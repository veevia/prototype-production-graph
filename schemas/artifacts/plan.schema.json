{
 "$defs": {
  "AcceptanceTrace": {
   "additionalProperties": false,
   "description": "Where the plan checks one acceptance line of a requirement (field run 2, R2-18: a P1 naming rule never reached\nthe plan, and every gate passed). Exactly one of: an expectation step, a `forbidden_text` entry, a check a later\nnode runs, or the reason it is out of scope for this prototype.",
   "properties": {
    "requirement": {
     "title": "Requirement",
     "type": "string"
    },
    "acceptance": {
     "title": "Acceptance",
     "type": "string"
    },
    "scenario": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Scenario"
    },
    "step": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Step"
    },
    "forbidden_text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Forbidden Text"
    },
    "covered_by": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Covered By"
    },
    "out_of_scope": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Out Of Scope"
    }
   },
   "required": [
    "requirement",
    "acceptance"
   ],
   "title": "AcceptanceTrace",
   "type": "object"
  },
  "Alignment": {
   "additionalProperties": false,
   "properties": {
    "status": {
     "enum": [
      "aligned",
      "pending"
     ],
     "title": "Status",
     "type": "string"
    },
    "with_whom": {
     "title": "With Whom",
     "type": "string"
    },
    "evidence_ids": {
     "items": {
      "type": "string"
     },
     "title": "Evidence Ids",
     "type": "array"
    }
   },
   "required": [
    "status",
    "with_whom"
   ],
   "title": "Alignment",
   "type": "object"
  },
  "AssumptionCheck": {
   "additionalProperties": false,
   "properties": {
